# Valores reais ficam só no EasyPanel / .env local — nunca no git.

PORT=3000
NODE_ENV=development

# Postgres do projeto (hostname interno no EasyPanel)
DATABASE_URL=postgres://prumo:prumo@localhost:5433/prumo

# Redis: rate-limit e debounce (não é a fila principal)
REDIS_URL=redis://localhost:6380

# Worker embutido no processo da API (1=sim). Em produção pode ser serviço separado.
RUN_WORKER=true

# Bootstrap no boot: cria tenant+canal listen_personal se não existir
# BOOTSTRAP_WEBHOOK_SECRET=
# BOOTSTRAP_SLUG=pessoal
# BOOTSTRAP_INSTANCE=
# BOOTSTRAP_OWNER_EMAIL=
# BOOTSTRAP_OWNER_PASSWORD=
# BOOTSTRAP_OWNER_NAME=

# Seed CLI (npm run seed)
# SEED_SLUG=pessoal
# SEED_INSTANCE=prumo-pessoal

# Evolution / OpenRouter
# EVOLUTION_URL=
# EVOLUTION_API_KEY=
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_HTTP_REFERER=
# OPENROUTER_APP_TITLE=Prumo
# AI_MODEL_STRUCTURE=google/gemini-2.5-flash-lite
