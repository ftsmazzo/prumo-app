# Valores reais ficam só no EasyPanel / .env local — nunca no git.

PORT=3000
NODE_ENV=development

# Postgres do projeto (hostname interno no EasyPanel)
DATABASE_URL=postgres://prumo:prumo@localhost:5432/prumo

# Redis: rate-limit e debounce (não é a fila principal)
REDIS_URL=redis://localhost:6379

